#!/usr/bin/env python3
"""Run a command at low priority under the shared ~/.cache/explainer-video-heavy.lock."""
import fcntl
import os
from pathlib import Path
import sys


def main():
    command = sys.argv[1:]
    if command[:1] == ["--"]:
        command = command[1:]
    if not command or command == ["--help"]:
        print("usage: scripts/run/heavy COMMAND [ARG ...]")
        return 0 if command else 2
    path = Path.home() / ".cache" / "explainer-video-heavy.lock"
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print(f"heavy: waiting for {path}", file=sys.stderr, flush=True)
            fcntl.flock(lock, fcntl.LOCK_EX)
        os.nice(10)
        # The command inherits the lock so a crash releases it without a stale lock file.
        os.set_inheritable(lock.fileno(), True)
        try:
            os.execvp(command[0], command)
        except OSError as exc:
            print(f"heavy: {exc}", file=sys.stderr)
            return 127


if __name__ == "__main__":
    sys.exit(main())
